<div class="<%= typeof colClass !== 'undefined' ? colClass : 'col-lg-4 col-md-6' %> mb-4">
    <div class="card feature-card h-100">
        <div class="card-body text-center p-4">
            <div class="mb-3">
                <i class="<%= icon %>" style="font-size: 3rem;"></i>
            </div>
            <h5 class="card-title mb-3"><%= title %></h5>
            <p class="card-text text-muted mb-4">
                <%= description %>
            </p>
            <div class="mt-auto">
                <button class="btn <%= typeof buttonClass !== 'undefined' ? buttonClass : 'btn-outline-primary' %> btn-ads">
                    <% if (typeof buttonIcon !== 'undefined') { %>
                        <i class="<%= buttonIcon %> me-2"></i>
                    <% } %>
                    <%= buttonText %>
                </button>
            </div>
        </div>
    </div>
</div>