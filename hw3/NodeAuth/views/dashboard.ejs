<%- include('partials/header', { title: 'Dashboard' }) %>

<%- include('partials/navbar', { user: user }) %>

    <div class="container mt-4">
        
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm mb-4">
                    <div class="card-body text-center p-4">
                        <h1 class="display-5 text-primary mb-3">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </h1>
                        <p class="lead">
                            Welcome back, 
                            <strong>
                                <% if (user.fullName) { %>
                                    <%= user.fullName %>
                                <% } else { %>
                                    <%= user.username %>
                                <% } %>
                            </strong>!
                        </p>
                        <p class="text-muted">Department of Applied Data Science</p>
                    </div>
                </div>
            </div>
        </div>

        
        <div class="row g-4">
            <% if (user.role === 'faculty') { %>
                
                <div class="col-md-4">
                    <div class="card feature-card h-100">
                        <div class="card-body text-center p-4">
                            <i class="bi bi-journal-code text-primary" style="font-size: 2.5rem;"></i>
                            <h5 class="card-title mt-3">Manage Courses</h5>
                            <p class="card-text text-muted">
                                Create and manage course content, upload materials, and organize curriculum.
                            </p>
                            <button class="btn btn-outline-primary">
                                <i class="bi bi-plus-circle"></i> Manage Courses
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card feature-card h-100">
                        <div class="card-body text-center p-4">
                            <i class="bi bi-graph-up text-success" style="font-size: 2.5rem;"></i>
                            <h5 class="card-title mt-3">Grade Analytics</h5>
                            <p class="card-text text-muted">
                                View class performance, grade distributions, and student progress reports.
                            </p>
                            <button class="btn btn-outline-success">
                                <i class="bi bi-bar-chart"></i> View Analytics
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card feature-card h-100">
                        <div class="card-body text-center p-4">
                            <i class="bi bi-people text-info" style="font-size: 2.5rem;"></i>
                            <h5 class="card-title mt-3">Manage Students</h5>
                            <p class="card-text text-muted">
                                View student roster, communicate with students, and manage office hours.
                            </p>
                            <button class="btn btn-outline-info">
                                <i class="bi bi-person-gear"></i> Manage Students
                            </button>
                        </div>
                    </div>
                </div>

            <% } else if (user.role === 'student') { %>
                
                <div class="col-md-4">
                    <div class="card feature-card h-100">
                        <div class="card-body text-center p-4">
                            <i class="bi bi-journal-code text-primary" style="font-size: 2.5rem;"></i>
                            <h5 class="card-title mt-3">View Assignments</h5>
                            <p class="card-text text-muted">
                                Access course assignments, due dates, and submission requirements.
                            </p>
                            <button class="btn btn-outline-primary">
                                <i class="bi bi-list-check"></i> View Assignments
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card feature-card h-100">
                        <div class="card-body text-center p-4">
                            <i class="bi bi-graph-up text-success" style="font-size: 2.5rem;"></i>
                            <h5 class="card-title mt-3">My Grades</h5>
                            <p class="card-text text-muted">
                                Check your grades, progress tracking, and academic performance.
                            </p>
                            <button class="btn btn-outline-success">
                                <i class="bi bi-trophy"></i> View Grades
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card feature-card h-100">
                        <div class="card-body text-center p-4">
                            <i class="bi bi-people text-info" style="font-size: 2.5rem;"></i>
                            <h5 class="card-title mt-3">Study Groups</h5>
                            <p class="card-text text-muted">
                                Join study groups, collaborate with classmates, and participate in discussions.
                            </p>
                            <button class="btn btn-outline-info">
                                <i class="bi bi-people-fill"></i> Join Groups
                            </button>
                        </div>
                    </div>
                </div>

            <% } else { %>
                
                <div class="col-md-4">
                    <div class="card feature-card h-100">
                        <div class="card-body text-center p-4">
                            <i class="bi bi-journal-code text-primary" style="font-size: 2.5rem;"></i>
                            <h5 class="card-title mt-3">System Management</h5>
                            <p class="card-text text-muted">
                                Manage system settings, user accounts, and platform configurations.
                            </p>
                            <button class="btn btn-outline-primary">
                                <i class="bi bi-gear-fill"></i> System Settings
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card feature-card h-100">
                        <div class="card-body text-center p-4">
                            <i class="bi bi-graph-up text-success" style="font-size: 2.5rem;"></i>
                            <h5 class="card-title mt-3">System Analytics</h5>
                            <p class="card-text text-muted">
                                Monitor system usage, performance metrics, and user activity reports.
                            </p>
                            <button class="btn btn-outline-success">
                                <i class="bi bi-activity"></i> View Reports
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card feature-card h-100">
                        <div class="card-body text-center p-4">
                            <i class="bi bi-people text-info" style="font-size: 2.5rem;"></i>
                            <h5 class="card-title mt-3">User Management</h5>
                            <p class="card-text text-muted">
                                Manage user accounts, roles, permissions, and access controls.
                            </p>
                            <button class="btn btn-outline-info">
                                <i class="bi bi-person-plus"></i> Manage Users
                            </button>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>

        
        <div class="row mt-5">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-lightning"></i> Quick Actions
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <% if (user.role === 'faculty') { %>
                                
                                <div class="col-md-3">
                                    <button class="btn btn-light w-100">
                                        <i class="bi bi-file-earmark-plus"></i><br>
                                        <small>Create Assignment</small>
                                    </button>
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-light w-100">
                                        <i class="bi bi-calendar-plus"></i><br>
                                        <small>Schedule Class</small>
                                    </button>
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-light w-100">
                                        <i class="bi bi-chat-square-text"></i><br>
                                        <small>Send Announcement</small>
                                    </button>
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-light w-100">
                                        <i class="bi bi-clipboard-check"></i><br>
                                        <small>Grade Submissions</small>
                                    </button>
                                </div>

                            <% } else if (user.role === 'student') { %>
                                
                                <div class="col-md-3">
                                    <button class="btn btn-light w-100">
                                        <i class="bi bi-file-earmark-text"></i><br>
                                        <small>Submit Assignment</small>
                                    </button>
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-light w-100">
                                        <i class="bi bi-calendar-event"></i><br>
                                        <small>View Schedule</small>
                                    </button>
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-light w-100">
                                        <i class="bi bi-chat-dots"></i><br>
                                        <small>Discussion Forum</small>
                                    </button>
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-light w-100">
                                        <i class="bi bi-book"></i><br>
                                        <small>Course Materials</small>
                                    </button>
                                </div>

                            <% } else { %>
                                
                                <div class="col-md-3">
                                    <button class="btn btn-light w-100">
                                        <i class="bi bi-person-plus"></i><br>
                                        <small>Add User</small>
                                    </button>
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-light w-100">
                                        <i class="bi bi-shield-check"></i><br>
                                        <small>Security Settings</small>
                                    </button>
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-light w-100">
                                        <i class="bi bi-database"></i><br>
                                        <small>System Backup</small>
                                    </button>
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-light w-100">
                                        <i class="bi bi-gear"></i><br>
                                        <small>System Settings</small>
                                    </button>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        
        <div class="row mt-4">
            <div class="col-md-6 mx-auto">
                <div class="card border-primary">
                    <div class="card-header bg-primary text-white text-center">
                        <i class="bi bi-person-badge"></i> Session Information
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-6"><strong>Username:</strong></div>
                            <div class="col-sm-6"><%= user.username %></div>
                        </div>
                        <% if (user.fullName) { %>
                        <div class="row mt-2">
                            <div class="col-sm-6"><strong>Full Name:</strong></div>
                            <div class="col-sm-6"><%= user.fullName %></div>
                        </div>
                        <% } %>
                        <% if (user.role) { %>
                        <div class="row mt-2">
                            <div class="col-sm-6"><strong>Role:</strong></div>
                            <div class="col-sm-6">
                                <span class="badge bg-primary"><%= user.role %></span>
                            </div>
                        </div>
                        <% } %>
                        <div class="row mt-2">
                            <div class="col-sm-6"><strong>User ID:</strong></div>
                            <div class="col-sm-6"><%= user.id %></div>
                        </div>
                        
                        <div class="text-center mt-4">
                            <a href="/logout" class="btn btn-danger">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-dark text-light text-center py-3 mt-5">
        <div class="container">
            <p class="mb-0">&copy; 2025 Department of Applied Data Science</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>